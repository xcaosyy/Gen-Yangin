---
import '../styles/global.css';
const { pageTitle = "Gen Yangın | Danışmanlık & Yapı Çözümleri", description = "Fabrika ve Oteller İçin Mevzuata Uygun Yangın Danışmanlığı & Anahtar Teslim Yapısal Çözümler" } = Astro.props;
---

<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    
    <!-- Türkçe Karakter Destekli Güvenli Font Ailesi -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-50 text-slate-800 font-['Plus_Jakarta_Sans',sans-serif] antialiased min-h-screen flex flex-col justify-between pt-20">

    <!-- SABİT KURUMSAL ÜST MENÜ -->
    <header class="fixed top-0 left-0 right-0 bg-white/95 backdrop-blur-md border-b border-slate-200/80 z-50">
      <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="group flex flex-col">
          <span class="text-2xl font-extrabold text-slate-900 tracking-tight">GEN <span class="text-red-600">YANGIN</span></span>
          <span class="text-[9px] text-slate-500 font-bold tracking-widest uppercase mt-0.5">DANIŞMANLIK & YAPI ÇÖZÜMLERİ</span>
        </a>
        
        <nav class="hidden md:flex items-center gap-6 text-sm font-bold text-slate-600">
          <a href="/" class="hover:text-red-600 transition">Anasayfa</a>
          <a href="/hakkimizda" class="hover:text-red-600 transition">Hakkımızda</a>
          <a href="/hizmetler" class="hover:text-red-600 transition">Hizmetler</a>
          <a href="/yonetmelik" class="hover:text-red-600 transition">Yönetmelik</a>
          
          <!-- MEVZUAT & BİLGİ MERKEZİ DROPDOWN ALANI -->
          <div class="relative group py-6">
            <a href="#" class="hover:text-red-600 transition flex items-center gap-1">
              Mevzuat & Bilgi <span class="text-[10px]">▼</span>
            </a>
            <div class="absolute top-full left-1/2 -translate-x-1/2 w-72 bg-white border border-slate-200 rounded-2xl shadow-xl py-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              <a href="/yangin-mevzuati-revizyonlari" class="block px-5 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-red-600 transition">📊 Mevzuat Revizyonları & Tarihçe</a>
              <a href="/yangin-sozlugu" class="block px-5 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-red-600 transition font-bold text-red-600">📖 Yangın Terimleri Sözlüğü</a>
            </div>
          </div>

          <a href="/iletisim" class="hover:text-red-600 transition">İletişim</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="tel:+905336626210" class="bg-slate-100 hover:bg-slate-200 text-slate-900 px-4 py-2.5 rounded-xl transition text-sm flex items-center gap-2 font-bold">
            📞 0 533 662 62 10
          </a>
          <a href="https://wa.me/905336626210" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl text-sm font-bold flex items-center gap-2 transition shadow-sm">
            💬 Ücretsiz Ön Keşif
          </a>
        </div>
      </div>
    </header>

    <!-- SAYFA İÇERİKLERİ -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-slate-900 text-slate-400 pt-16 pb-8 border-t-4 border-red-600">
      <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
        <div>
          <h4 class="text-white text-xl font-extrabold mb-3">GEN <span class="text-red-600">YANGIN</span></h4>
          <p class="text-sm leading-relaxed mb-4">Mevzuata Uygun Risk Analizi, Projelendirme ve Profesyonel Uygulama Hizmetleri.</p>
          <div class="space-y-2 text-sm">
            <p>📍 Dinçer Mh. 2301 Sok. No:23/A Şehzadeler / Manisa</p>
          </div>
        </div>
        <div>
          <h5 class="text-white text-sm font-bold uppercase tracking-wider mb-4">Hizmetler</h5>
          <ul class="space-y-2 text-sm font-medium">
            <li>Mevzuat Danışmanlığı & Risk Analizi</li>
            <li>Kaçış Yolları & Tahliye Planlaması</li>
            <li>Yapısal Uygulamalar & Mimari Tadilat</li>
            <li>Eğitici Eğitimi & Belgelendirme</li>
          </ul>
        </div>
        <div>
          <h5 class="text-white text-sm font-bold uppercase tracking-wider mb-4">İletişim</h5>
          <p class="text-sm font-bold text-slate-300">📧 info@genyangin.com</p>
          <p class="text-sm font-bold text-slate-300 mt-1">📞 0 533 662 62 10</p>
        </div>
      </div>
      <div class="max-w-6xl mx-auto px-6 pt-6 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center text-xs gap-4 font-medium">
        <div>
          &copy; 2026 Gen Yangın Danışmanlık & Yapı Çözümleri. Tüm Hakları Saklıdır. | Created by <a href="https://ablmedya.com" target="_blank" class="text-slate-300 hover:text-red-500 font-bold transition">ABL Medya</a>
        </div>
      </div>
    </footer>

  </body>
</html>
---
import '../styles/global.css';
const { pageTitle = "Gen Yangın | Danışmanlık & Yapı Çözümleri", description = "Fabrika ve Oteller İçin Mevzuata Uygun Yangın Danışmanlığı & Anahtar Teslim Yapısal Çözümler" } = Astro.props;

// Aktif sayfayı yakalamak için url yolunu alıyoruz
const currentPath = Astro.url.pathname;
---

<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style is:global>
      /* --- GERÇEKÇİ YANGIN VE KOR EFEKTİ --- */
      .burning-link {
        position: relative;
        color: #64748b;
        transition: color 0.3s ease;
      }

      /* Aktif olan veya üzerine gelinen sayfa cayır cayır yanacak */
      .burning-link.active, .burning-link:hover {
        color: #ff3c00 !important;
        font-weight: 900;
        text-shadow: 
          0 0 4px #ff3c00, 
          0 -2px 8px #ff7300, 
          0 -4px 12px #ffb700, 
          0 -10px 20px #ff3c00;
        animation: fireFlicker 0.15s ease-in-out infinite alternate;
      }

      /* Yanan kelimenin altına kül ve kor çizgisi */
      .burning-link::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, #ff3c00, #ffb700, transparent);
        box-shadow: 0 2px 10px #ff3c00;
        transition: width 0.3s ease;
      }

      .burning-link.active::after, .burning-link:hover::after {
        width: 100%;
      }

      /* Ateşin titreme ve dalgalanma animasyonu */
      @keyframes fireFlicker {
        0% { text-shadow: 0 0 4px #ff3c00, 0 -2px 6px #ff7300, 0 -4px 10px #ffb700, 0 -8px 15px #ff3c00; transform: scale(1.01) skewX(-1deg); }
        100% { text-shadow: 0 0 6px #ff3c00, 0 -4px 10px #ff7300, 0 -8px 16px #ffb700, 0 -12px 25px #ff3c00; transform: scale(0.99) skewX(1deg); filter: brightness(1.3); }
      }

      /* Hamburger Buton Animasyonu */
      #menu-btn.open .line-1 { transform: rotate(45deg) translate(6px, 6px); background-color: #ff3c00; }
      #menu-btn.open .line-2 { opacity: 0; }
      #menu-btn.open .line-3 { transform: rotate(-45deg) translate(6px, -6px); background-color: #ff3c00; }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-800 font-['Plus_Jakarta_Sans',sans-serif] antialiased min-h-screen flex flex-col justify-between pt-20">

    <header class="fixed top-0 left-0 right-0 bg-white/95 backdrop-blur-md border-b border-slate-200/80 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
        
        <a href="/" class="group flex flex-col z-50">
          <span class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">GEN <span class="text-red-600">YANGIN</span></span>
          <span class="text-[8px] sm:text-[9px] text-slate-500 font-bold tracking-widest uppercase mt-0.5">DANIŞMANLIK & YAPI ÇÖZÜMLERİ</span>
        </a>
        
        <nav class="hidden md:flex items-center gap-6 text-sm font-bold">
          <a href="/" class={`burning-link ${currentPath === '/' ? 'active' : ''}`}>Anasayfa</a>
          <a href="/hakkimizda" class={`burning-link ${currentPath === '/hakkimizda' ? 'active' : ''}`}>Hakkımızda</a>
          <a href="/hizmetler" class={`burning-link ${currentPath === '/hizmetler' ? 'active' : ''}`}>Hizmetler</a>
          <a href="/yonetmelik" class={`burning-link ${currentPath === '/yonetmelik' ? 'active' : ''}`}>Yönetmelik</a>
          <a href="/iletisim" class={`burning-link ${currentPath === '/iletisim' ? 'active' : ''}`}>İletişim</a>
        </nav>

        <div class="flex items-center gap-2 sm:gap-3">
          <a href="tel:+905336626210" class="hidden sm:flex bg-slate-100 hover:bg-slate-200 text-slate-900 px-4 py-2.5 rounded-xl transition text-sm items-center gap-2 font-bold">
            📞 0 533 662 62 10
          </a>
          <a href="https://wa.me/905336626210" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition shadow-sm z-50">
            💬 Ön Keşif
          </a>

          <button id="menu-btn" class="flex flex-col justify-between w-6 h-5 md:hidden z-50 focus:outline-none" aria-label="Menü">
            <span class="line-1 w-full h-0.5 bg-slate-900 rounded transition-all duration-300"></span>
            <span class="line-2 w-full h-0.5 bg-slate-900 rounded transition-all duration-300"></span>
            <span class="line-3 w-full h-0.5 bg-slate-900 rounded transition-all duration-300"></span>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="fixed inset-0 bg-slate-950 z-40 flex flex-col justify-center items-center transition-all duration-300 transform translate-x-full opacity-0 pointer-events-none md:hidden">
        <nav class="flex flex-col items-center gap-8 text-2xl font-black tracking-wide">
          <a href="/" class={`burning-link text-3xl ${currentPath === '/' ? 'active' : ''}`}>Anasayfa</a>
          <a href="/hakkimizda" class={`burning-link text-3xl ${currentPath === '/hakkimizda' ? 'active' : ''}`}>Hakkımızda</a>
          <a href="/hizmetler" class={`burning-link text-3xl ${currentPath === '/hizmetler' ? 'active' : ''}`}>Hizmetler</a>
          <a href="/yonetmelik" class={`burning-link text-3xl ${currentPath === '/yonetmelik' ? 'active' : ''}`}>Yönetmelik</a>
          <a href="/yangin-mevzuati-revizyonlari" class={`burning-link text-xl ${currentPath === '/yangin-mevzuati-revizyonlari' ? 'active' : ''}`}>📊 Mevzuat Revizyonları</a>
          <a href="/yangin-sozlugu" class={`burning-link text-xl ${currentPath === '/yangin-sozlugu' ? 'active' : ''}`}>📖 Yangın Sözlüğü</a>
          <a href="/iletisim" class={`burning-link text-3xl ${currentPath === '/iletisim' ? 'active' : ''}`}>İletişim</a>
          
          <div class="w-32 h-px bg-gradient-to-r from-transparent via-red-600 to-transparent my-2"></div>
          <a href="tel:+905336626210" class="text-sm font-bold text-slate-400">📞 0 533 662 62 10</a>
        </nav>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-400 pt-16 pb-8 border-t-4 border-red-600">
      <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
        <div>
          <h4 class="text-white text-xl font-extrabold mb-3">GEN <span class="text-red-600">YANGIN</span></h4>
          <p class="text-sm leading-relaxed mb-4">Mevzuata Uygun Risk Analizi, Projelendirme ve Profesyonel Uygulama Hizmetleri.</p>
          <div class="space-y-2 text-sm">
            <p>📍 Dinçer Mh. 2301 Sok. No:23/A Şehzadeler / Manisa</p>
          </div>
        </div>
        <div>
          <h5 class="text-white text-sm font-bold uppercase tracking-wider mb-4">Hizmetler</h5>
          <ul class="space-y-2 text-sm font-medium">
            <li>Mevzuat Danışmanlığı & Risk Analizi</li>
            <li>Kaçış Yolları & Tahliye Planlaması</li>
            <li>Yapısal Uygulamalar & Mimari Tadilat</li>
            <li>Eğitici Eğitimi & Belgelendirme</li>
          </ul>
        </div>
        <div>
          <h5 class="text-white text-sm font-bold uppercase tracking-wider mb-4">İletişim</h5>
          <p class="text-sm font-bold text-slate-300">📧 info@genyangin.com</p>
          <p class="text-sm font-bold text-slate-300 mt-1">📞 0 533 662 62 10</p>
        </div>
      </div>
      <div class="max-w-6xl mx-auto px-6 pt-6 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center text-xs gap-4 font-medium">
        <div>
          &copy; 2026 Gen Yangın Danışmanlık & Yapı Çözümleri. Tüm Hakları Saklıdır. | Created by <a href="https://ablmedya.com" target="_blank" class="text-slate-300 hover:text-red-500 font-bold transition">ABL Medya</a>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          menuBtn.classList.toggle('open');
          
          if (mobileMenu.classList.contains('translate-x-full')) {
            mobileMenu.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
            mobileMenu.classList.add('translate-x-0', 'opacity-100', 'pointer-events-auto');
            document.body.style.overflow = 'hidden';
          } else {
            mobileMenu.classList.remove('translate-x-0', 'opacity-100', 'pointer-events-auto');
            mobileMenu.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none');
            document.body.style.overflow = '';
          }
        });
      }
    </script>
  </body>
</html>
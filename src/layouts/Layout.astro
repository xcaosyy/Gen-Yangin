---
import '../styles/global.css';
import JsonLd from '../components/JsonLd.astro';
import { discoveryLinks, siteConfig } from '../data/site';

const {
  pageTitle = "Gen Yangın | Yangın Danışmanlığı ve Anahtar Teslim Yapısal Çözümler",
  description = siteConfig.description,
  canonical,
  ogType = "website",
  noindex = false,
  jsonLd = [],
} = Astro.props;

const normalizedPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const canonicalPath = canonical ?? normalizedPath;
const canonicalUrl = canonicalPath.startsWith("http")
  ? canonicalPath
  : `${siteConfig.siteUrl}${canonicalPath === "/" ? "/" : canonicalPath}`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteConfig.siteUrl}/#organization`,
  name: siteConfig.name,
  legalName: siteConfig.legalName,
  url: siteConfig.siteUrl,
  email: siteConfig.email,
  telephone: siteConfig.phone,
  sameAs: siteConfig.sameAs,
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${siteConfig.siteUrl}/#localbusiness`,
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  description: siteConfig.description,
  telephone: siteConfig.phone,
  email: siteConfig.email,
  address: {
    "@type": "PostalAddress",
    ...siteConfig.address,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: siteConfig.geo.latitude,
    longitude: siteConfig.geo.longitude,
  },
  areaServed: [
    "Manisa",
    "İzmir",
    "Aydın",
    "Denizli",
    "Muğla",
    "Balıkesir",
    "Türkiye",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteConfig.siteUrl}/#website`,
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  publisher: {
    "@id": `${siteConfig.siteUrl}/#organization`,
  },
};

const pageSchemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];

// Aktif sayfayı yakalamak için url yolunu alıyoruz
const currentPath = Astro.url.pathname;
---

<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <JsonLd data={organizationSchema} />
    <JsonLd data={localBusinessSchema} />
    <JsonLd data={websiteSchema} />
    {pageSchemas.map((schema) => schema && <JsonLd data={schema} />)}
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style is:global>
      /* --- MASAÜSTÜ MENÜ LİNKLERİ (BASİT HOVER) --- */
      .nav-link {
        color: #475569;
        transition: color 0.3s ease;
      }
      .nav-link:hover {
        color: #dc2626 !important;
      }
      /* Aktif sayfa kırmızı kurumsal renk */
      .nav-link.active {
        color: #dc2626 !important;
        font-weight: 800;
      }

      /* --- MOBİL MENÜ LİNKLERİ (ALEVLİ KOR EFEKTİ) --- */
      .mobile-link {
        color: rgba(255, 255, 255, 0.9);
        transition: all 0.2s ease;
      }
      /* Aktif veya hover olunan link sarı kor gibi parlayacak */
      .mobile-link.active, .mobile-link:hover {
        color: #fde047 !important;
        text-shadow: 0 0 10px #f97316, 0 0 20px #ef4444, 0 0 30px #fde047;
        transform: scale(1.05);
        animation: fireFlicker 0.15s ease-in-out infinite alternate;
      }

      /* Ateşin titreme animasyonu */
      @keyframes fireFlicker {
        0% { transform: scale(1.01) skewX(-1deg); filter: brightness(1.1); }
        100% { transform: scale(0.99) skewX(1deg); filter: brightness(1.3); }
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-800 font-['Plus_Jakarta_Sans',sans-serif] antialiased min-h-screen flex flex-col justify-between pt-20">

    <header class="fixed top-0 left-0 right-0 bg-white/95 z-40 border-b border-slate-200/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between backdrop-blur-md md:backdrop-blur-none">
        
        <div class="flex items-center gap-4">
          <button id="menu-open-btn" class="md:hidden p-1 focus:outline-none" aria-label="Menüyü Aç">
            <svg class="w-7 h-7 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
          
          <a href="/" class="group flex flex-col z-50">
            <span class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">GEN <span class="text-red-600">YANGIN</span></span>
            <span class="text-[8px] sm:text-[9px] text-slate-500 font-bold tracking-widest uppercase mt-0.5">DANIŞMANLIK & YAPI ÇÖZÜMLERİ</span>
          </a>
        </div>
        
        <nav class="hidden md:flex items-center gap-6 text-sm font-bold text-slate-600">
          <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>Anasayfa</a>
          <a href="/hakkimizda" class={`nav-link ${currentPath === '/hakkimizda' ? 'active' : ''}`}>Hakkımızda</a>
          <a href="/hizmetler" class={`nav-link ${currentPath === '/hizmetler' ? 'active' : ''}`}>Hizmetler</a>
          <a href="/yonetmelik" class={`nav-link ${currentPath === '/yonetmelik' ? 'active' : ''}`}>Yönetmelik</a>
          <a href="/iletisim" class={`nav-link ${currentPath === '/iletisim' ? 'active' : ''}`}>İletişim</a>
        </nav>

        <div class="hidden md:flex items-center gap-3">
          <a href="tel:+905336626210" class="bg-slate-100 hover:bg-slate-200 text-slate-900 px-4 py-2.5 rounded-xl transition text-sm font-bold">
            📞 0 533 662 62 10
          </a>
          <a href="https://wa.me/905336626210" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl text-sm font-bold transition shadow-sm">
            💬 Ücretsiz Ön Keşif
          </a>
        </div>

      </div>
    </header>

    <div id="mobile-menu" class="fixed inset-0 bg-gradient-to-br from-red-700 via-red-600 to-red-900 z-50 flex-col items-center justify-center transition-transform duration-300 transform -translate-x-full hidden md:hidden p-6">
      
      <button id="menu-close-btn" class="absolute top-6 right-6 text-white p-2 focus:outline-none" aria-label="Menüyü Kapat">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>

      <nav class="flex flex-col items-center gap-6 text-xl font-black tracking-wide w-full text-white">
        <a href="/" class={`mobile-link ${currentPath === '/' ? 'active' : ''}`}>Anasayfa</a>
        <a href="/hakkimizda" class={`mobile-link ${currentPath === '/hakkimizda' ? 'active' : ''}`}>Hakkımızda</a>
        <a href="/hizmetler" class={`mobile-link ${currentPath === '/hizmetler' ? 'active' : ''}`}>Hizmetler</a>
        <a href="/yonetmelik" class={`mobile-link ${currentPath === '/yonetmelik' ? 'active' : ''}`}>Yönetmelik</a>
        <a href="/yangin-mevzuati-revizyonlari" class={`mobile-link text-lg ${currentPath === '/yangin-mevzuati-revizyonlari' ? 'active' : ''}`}>📊 Mevzuat Revizyonları</a>
        <a href="/yangin-sozlugu" class={`mobile-link text-lg ${currentPath === '/yangin-sozlugu' ? 'active' : ''}`}>📖 Yangın Sözlüğü</a>
        <a href="/iletisim" class={`mobile-link ${currentPath === '/iletisim' ? 'active' : ''}`}>İletişim</a>
        
        <div class="w-32 h-px bg-white/20 my-2"></div>
        
        <a href="https://wa.me/905336626210" target="_blank" class="bg-white text-red-700 px-8 py-3 rounded-2xl text-base font-extrabold flex items-center gap-2 shadow-2xl">
          💬 Ücretsiz Ön Keşif
        </a>
        <a href="tel:+905336626210" class="text-sm font-bold text-white/70 mt-2">📞 0 533 662 62 10</a>
      </nav>
    </div>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-400 pt-16 pb-8 border-t-4 border-red-600">
      <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
        <div>
          <h4 class="text-white text-xl font-extrabold mb-3">GEN <span class="text-red-600">YANGIN</span></h4>
          <p class="text-sm leading-relaxed mb-4">Mevzuata Uygun Risk Analizi, Projelendirme ve Profesyonel Uygulama Hizmetleri.</p>
          <div class="space-y-2 text-sm">
            <p>📍 Dinçer Mh. 2301 Sok. No:23/A Şehzadeler / Manisa</p>
          </div>
        </div>
        <div>
          <h5 class="text-white text-sm font-bold uppercase tracking-wider mb-4">Hizmetler</h5>
          <ul class="space-y-2 text-sm font-medium">
            {discoveryLinks.primary.slice(0, 5).map((link) => (
              <li>
                <a href={link.href} class="hover:text-white transition">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h5 class="text-white text-sm font-bold uppercase tracking-wider mb-4">İletişim</h5>
          <p class="text-sm font-bold text-slate-300">📧 info@genyangin.com</p>
          <p class="text-sm font-bold text-slate-300 mt-1">📞 0 533 662 62 10</p>
          <a href="/site-haritasi" class="inline-block text-sm font-bold text-slate-300 hover:text-white transition mt-4">Site Haritası</a>
        </div>
      </div>
      <div class="max-w-6xl mx-auto px-6 pt-6 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center text-xs gap-4 font-medium">
        <div>
          &copy; 2026 Gen Yangın Danışmanlık & Yapı Çözümleri. Tüm Hakları Saklıdır. | Created by <a href="https://ablmedya.com" target="_blank" class="text-slate-300 hover:text-red-500 font-bold transition">ABL Medya</a>
        </div>
      </div>
    </footer>

    <script>
      const openBtn = document.getElementById('menu-open-btn');
      const closeBtn = document.getElementById('menu-close-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      if (openBtn && closeBtn && mobileMenu) {
        openBtn.addEventListener('click', () => {
          mobileMenu.classList.remove('hidden');
          mobileMenu.classList.add('flex');
          // CSS transform çalışması için milisaniyelik gecikme
          setTimeout(() => {
            mobileMenu.classList.remove('-translate-x-full');
            document.body.style.overflow = 'hidden';
          }, 10);
        });

        closeBtn.addEventListener('click', () => {
          mobileMenu.classList.add('-translate-x-full');
          document.body.style.overflow = '';
          // Animasyon bitince ekranı temizle
          setTimeout(() => {
            mobileMenu.classList.add('hidden');
            mobileMenu.classList.remove('flex');
          }, 300);
        });
      }
    </script>
  </body>
</html>

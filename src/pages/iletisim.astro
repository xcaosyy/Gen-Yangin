---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  pageTitle="İletişim & Ücretsiz Ön Keşif Başvurusu | Gen Yangın"
  description="Gen Yangın Manisa merkez ofisi iletişim bilgileri. Yangın danışmanlığı, risk analizi ve itfaiye uygunluk belgesi süreçleri için bizimle iletişime geçin."
>
  
  <!-- ÜST BANNER -->
  <section class="bg-slate-900 text-white py-16 px-6 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--color-red-950),_transparent_50%)]"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <span class="text-xs font-bold bg-red-600/20 text-red-400 px-3 py-1.5 rounded-full uppercase tracking-widest border border-red-500/30">Kesintisiz Destek</span>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight mt-4 mb-4">Bizimle İletişime Geçin</h1>
      <p class="text-slate-400 max-w-xl mx-auto text-xs md:text-sm">
        Tesisinizin yangın güvenliği ve resmi ruhsatlandırma süreçleri hakkında sormak istediğiniz her şey için Gen Yangın | Yangın Danışmanı kadromuzla yanınızdayız.
      </p>
    </div>
  </section>

  <!-- İLETİŞİM KANALLARI VE BLOKLAR -->
  <section class="py-16 max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- SOL TARAF: İLETİŞİM KARTLARI -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Telefon Kartı -->
        <a href="tel:+905336626210" class="block bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:border-red-500 transition group">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-red-50 text-red-600 rounded-xl flex items-center justify-center text-xl font-bold group-hover:bg-red-600 group-hover:text-white transition">
              📞
            </div>
            <div>
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">7/24 Teknik Hat</span>
              <span class="text-base font-black text-slate-900">0 533 662 62 10</span>
            </div>
          </div>
        </a>

        <!-- WhatsApp Hızlı İletişim -->
        <a href="https://wa.me/905336626210" target="_blank" class="block bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:border-emerald-500 transition group">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl font-bold group-hover:bg-emerald-600 group-hover:text-white transition">
              💬
            </div>
            <div>
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Hızlı WhatsApp Çözümü</span>
              <span class="text-base font-black text-slate-900">Gen Yangın Proje Hattı</span>
            </div>
          </div>
        </a>

        <!-- E-Posta Kartı -->
        <a href="mailto:info@genyangin.com" class="block bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:border-red-500 transition group">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-slate-100 text-slate-700 rounded-xl flex items-center justify-center text-xl font-bold group-hover:bg-slate-900 group-hover:text-white transition">
              📧
            </div>
            <div>
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Kurumsal E-Posta</span>
              <span class="text-base font-black text-slate-900">info@genyangin.com</span>
            </div>
          </div>
        </a>

        <!-- Instagram Kartı -->
        <a href="https://instagram.com/genyangin" target="_blank" class="block bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:border-purple-500 transition group">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-xl font-bold group-hover:bg-gradient-to-tr group-hover:from-amber-500 group-hover:via-red-500 group-hover:to-purple-600 group-hover:text-white transition">
              📸
            </div>
            <div>
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Sosyal Medya / Dijital Saha</span>
              <span class="text-base font-black text-slate-900">@genyangin</span>
            </div>
          </div>
        </a>

        <!-- Adres Kartı -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl font-bold shrink-0">
              📍
            </div>
            <div>
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Merkez Ofis</span>
              <p class="text-xs md:text-sm font-bold text-slate-900 mt-1 leading-relaxed">
                GEN YAPI & GY İÇMİMARLIK<br/>Dinçer, 2301. Sk. No:23/A, 45020 Şehzadeler/Manisa
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- SAĞ TARAF: GOOGLE MAPS VE DIJITAL FORMASYON -->
      <div class="lg:col-span-7 bg-white border border-slate-200 rounded-3xl p-4 shadow-sm h-full min-h-[450px] flex flex-col">
        <div class="flex justify-between items-center p-2 mb-2">
          <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Google Haritalar Ofis Konumu</h3>
          <a href="https://maps.app.goo.gl/FwRecuo1xAryPQWv6" target="_blank" class="text-[11px] font-bold text-red-600 hover:underline">Haritada Büyük Göster ↗</a>
        </div>
        
        <!-- GEN YAPI & GY İÇMİMARLIK Nokta Atışı Canlı Harita İframe -->
        <div class="w-full flex-grow rounded-2xl overflow-hidden border border-slate-100 min-h-[380px]">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3119.5630325916053!2d27.42293437648348!3d38.61287376326694!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14b97f0037eb9315%3A0xc3e407a518296768!2sGEN%20YAPI%20%26%20GY%20w4w4w4%20w4w4w4!5e0!3m2!1str!2str!4v1718696000000!5m2!1str!2str" 
            class="w-full h-full border-0" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

    </div>
  </section>
</Layout>
  <script>
    // 1. Sektörel Rehber Tab Motoru
    const buttons = document.querySelectorAll('.tab-btn');
    const sections = document.querySelectorAll('.content-section');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');

        buttons.forEach(b => {
          b.classList.remove('border-red-500', 'text-red-600', 'bg-red-50/30');
          b.classList.add('border-slate-200', 'text-slate-700', 'bg-white');
        });
        btn.classList.remove('border-slate-200', 'text-slate-700', 'bg-white');
        btn.classList.add('border-red-500', 'text-red-600', 'bg-red-50/30');

        sections.forEach(sec => {
          if (sec.getAttribute('id') === target) {
            sec.classList.remove('hidden');
          } else {
            sec.classList.add('hidden');
          }
        });
      });
    });

    if(buttons[0]) {
      (buttons[0] as HTMLButtonElement).click();
    }

    // 2. Yeni S.S.S. Akordeon Animasyon Motoru
    const faqBtns = document.querySelectorAll('.faq-btn');
    faqBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const ans = btn.nextElementSibling as HTMLDivElement;
        const icon = btn.querySelector('.faq-icon') as HTMLSpanElement;
        
        if (ans.style.maxHeight && ans.style.maxHeight !== '0px') {
          ans.style.maxHeight = '0px';
          icon.style.transform = 'rotate(0deg)';
        } else {
          document.querySelectorAll('.faq-ans').forEach(el => (el as HTMLDivElement).style.maxHeight = '0px');
          document.querySelectorAll('.faq-icon').forEach(el => (el as HTMLSpanElement).style.transform = 'rotate(0deg)');
          
          ans.style.maxHeight = ans.scrollHeight + 'px';
          icon.style.transform = 'rotate(180deg)';
        }
      });
    });
  </script>

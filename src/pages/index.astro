---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="relative py-24 md:py-32 overflow-hidden bg-white">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--color-red-50),_transparent_50%)]"></div>
    <div class="max-w-6xl mx-auto px-6 relative z-10 text-center">
      <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-bold bg-red-50 text-red-600 uppercase tracking-wider mb-6 border border-red-100 shadow-sm">
        Yönetmelik Engellerine Takılmayın!
      </span>
      <h1 class="text-4xl md:text-6xl font-black text-slate-900 tracking-tight leading-[1.1] max-w-4xl mx-auto mb-6">
        İşletmeniz Yangın Yönetmeliğine ve Denetimlere Ne Kadar Hazır?
      </h1>
      <p class="text-lg md:text-xl text-slate-600 max-w-3xl mx-auto mb-10 leading-relaxed">
        Fabrika ve oteller için mevzuata uygun yangın danışmanlığı ve anahtar teslim yapısal çözümlerle denetimlerden tek seferde geçin.
      </p>
      
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a href="https://wa.me/905336626210" target="_blank" class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-bold px-8 py-4 rounded-xl shadow-lg transition transform hover:-translate-y-0.5 text-center">
          Projeniz İçin Teknik Danışmanlık Alın 🧠
        </a>
        <a href="/hizmetler" class="w-full sm:w-auto bg-slate-100 hover:bg-slate-200 text-slate-900 font-bold px-8 py-4 rounded-xl transition text-center border border-slate-200">
          Sektörel Çözümlerimiz & Standartlar 🏢
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-900 text-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-4">İşletmeniz Risk Altında Mı?</h2>
        <p class="text-slate-400 text-base md:text-lg">Resmi denetimlerde ve ruhsatlandırma süreçlerinde işletmeleri en çok zor durumda bırakan ve cezai müeyyidelere yol açan eksiklikler:</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
          <div class="text-red-500 text-2xl mb-3">⚠️</div>
          <h3 class="text-xl font-bold mb-2">Hatalı Kaçış Yolları</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Kaçış mesafelerinin yönetmeliğe uygun hesaplanmaması, genişlik standartlarına uyulmaması ve çıkış yollarının engellenmiş olması.</p>
        </div>
        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
          <div class="text-red-500 text-2xl mb-3">⚠️</div>
          <h3 class="text-xl font-bold mb-2">Standart Dışı Yangın Merdivenleri</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Konumu, basamak genişliği, rıht yüksekliği veya malzemesi yönetmelik kriterlerini karşılamayan hatalı yapılar.</p>
        </div>
        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
          <div class="text-red-500 text-2xl mb-3">⚠️</div>
          <h3 class="text-xl font-bold mb-2">Yanlış Yangın Kapısı Seçimi</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Sertifikasız, yangın dayanım süresi yetersiz olan veya kaçış yönünün tersine açılan kapıların kullanılması.</p>
        </div>
        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
          <div class="text-red-500 text-2xl mb-3">⚠️</div>
          <h3 class="text-xl font-bold mb-2">Eksik Eğitim ve Risk Analizleri</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Personelin acil durum senaryolarından habersiz olması ve yasal olarak bulundurulması gereken yangın eğitimi belgelerinin eksikliği.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="hakkimizda" class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <span class="text-red-600 font-bold tracking-wider text-sm uppercase">BİZ KİMİZ?</span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight mt-2">Neden Gen Yangın?</h2>
      </div>
      <div class="space-y-8 text-slate-600 leading-relaxed text-base">
        <p class="text-slate-700 text-center max-w-2xl mx-auto">
          Yangın güvenliği sektöründeki en büyük aksaklık; mevzuatı ve yasal yükümlülükleri bilen danışman kadrosu ile sahada imalat ve tadilatı gerçekleştiren uygulayıcı ekibin farklı dilleri konuşmasıdır. Gen Yangın, teorik mevzuat bilgisi ile saha pratiğini tek çatı altında birleştirerek bu kopukluğu tamamen ortadan kaldırır.
        </p>
        <div class="bg-red-50 p-8 rounded-2xl border border-red-100 my-6">
          <h3 class="text-xl font-extrabold text-red-700 mb-3 text-center">Bizi Farklı Kılan Çift Yönlü Uzmanlığımız</h3>
          <p class="text-slate-800 font-medium mb-4 text-center">
            Firmamız, 3. Seviye Yangın Eğitici Eğitimi ve Yangın Risk Değerlendirme Eğitici Eğitimi yetkinlikleriyle işin yasal ve teorik altyapısını kusursuz kurar.
          </p>
          <p class="text-slate-700 text-center">
            Aynı zamanda, müteahhitlik ve inşaat tecrübemiz sayesinde projenizin gerektirdiği tüm yapısal tadilatları (yangın merdiveni, yangın kapısı, kaçış yolları) bizzat imal ederek anahtar teslim çözer. En pratik ve en ekonomik alternatif mimari yolları geliştirir.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50 border-t border-slate-200/50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-red-600 font-bold tracking-wider text-sm uppercase">TEK MUHATAP, KESİN ÇÖZÜM</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-2">Hizmet Alanlarımız</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
          <div class="text-3xl mb-4">📋</div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Mevzuat Danışmanlığı & Risk Analizi</h3>
          <p class="text-slate-600 text-xs leading-relaxed">İtfaiye uygunluk belgesi ve ruhsat öncesi eksiklerin resmi kriterlere göre detaylı raporlanması.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
          <div class="text-3xl mb-4">🚪</div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Kaçış Yolları & Tahliye Planlaması</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Yönetmeliğe uygun kaçış rotalarının belirlenmesi, genişlik ve mesafe hesaplamalarının sıfır hata ile yapılması.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
          <div class="text-3xl mb-4">🏗️</div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Yapısal Uygulamalar & Mimari Tadilat</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Statik hesabı yapılmış yangın merdiveni imalatı, sertifikalı yangın kapısı temini ve panik bar montajı.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
          <div class="text-3xl mb-4">🎓</div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Eğitici Eğitimi & Belgelendirme</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Yasal olarak zorunlu personel yangın eğitimlerinin verilmesi, acil durum tatbikatları ve resmi belgelendirme.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white border-t border-b border-slate-200/60">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold bg-red-50 text-red-600 px-3 py-1.5 rounded-full uppercase tracking-wider">Gen Yangın | Mevzuat Analiz Simülatörü</span>
        <h2 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight mt-4 mb-3">Mevzuat Risk ve Altyapı Hesaplayıcı</h2>
        <p class="text-slate-600 text-xs md:text-sm">Yasal olarak hangi sistemleri kurmak zorunda olduğunuzu ogulama tahmini bütçe bareminizi binaların yangından korunması hakkında yönetmelik kriterlerine göre anında simüle edin.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-5 bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-5">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">1. İşletme Yapı Türü</label>
            <select id="calc-type" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs font-semibold text-slate-800 focus:outline-none focus:border-red-500">
              <option value="otel">🏨 Otel / Konaklama Tesisi</option>
              <option value="fabrika">🏭 Fabrika / İmalathane</option>
              <option value="depo">📦 Endüstriyel Depo / Antrepo</option>
              <option value="otopark">🚗 Kapalı Otopark Alanı</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">2. Toplam Kapalı Alan (m²)</label>
            <input type="number" id="calc-area" value="1000" min="50" step="50" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs font-semibold text-slate-800 focus:outline-none focus:border-red-500" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">3. Toplam Kat Sayısı</label>
            <input type="number" id="calc-floors" value="2" min="1" max="30" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs font-semibold text-slate-800 focus:outline-none focus:border-red-500" />
          </div>
          <button id="calc-trigger" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-3.5 rounded-xl text-xs transition shadow-md">
            Mevzuat Analizini Başlat ⚡
          </button>
        </div>

        <div class="lg:col-span-7 bg-slate-900 text-white p-8 rounded-3xl shadow-xl border-t-4 border-red-600 space-y-6">
          <div class="flex justify-between items-center border-b border-slate-800 pb-4">
            <h3 class="font-extrabold text-sm md:text-base tracking-tight text-slate-100">📋 Yasal Zorunluluk Simülasyonu</h3>
            <span id="res-risk" class="text-[10px] font-bold bg-red-600/20 text-red-400 px-2.5 py-1 rounded-full border border-red-500/30 uppercase tracking-wide">Yüksek Risk Derecesi</span>
          </div>
          <div class="space-y-3 text-xs">
            <div class="flex items-start gap-3 p-3 bg-slate-950/50 rounded-xl border border-slate-800/60">
              <span id="icon-merdiven" class="text-base">🚨</span>
              <div>
                <h4 class="font-bold text-slate-200">Yangın Kaçış Merdiveni Sınırı:</h4>
                <p id="txt-merdiven" class="text-slate-400 mt-0.5">Kat sayısı ve kullanıcı yükü sınırında alternatif çift merdiven zorunludur.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-3 bg-slate-950/50 rounded-xl border border-slate-800/60">
              <span id="icon-sprinkler" class="text-base">💦</span>
              <div>
                <h4 class="font-bold text-slate-200">Otomatik Sprinkler (Yağmurlama):</h4>
                <p id="txt-sprinkler" class="text-slate-400 mt-0.5">Alan ölçüm limitlerinize bağlı olarak fıskiye şebekesi kurulmalıdır.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-3 bg-slate-950/50 rounded-xl border border-slate-800/60">
              <span id="icon-duman" class="text-base">🌀</span>
              <div>
                <h4 class="font-bold text-slate-200">Mekanik Duman Tahliye Havalandırması:</h4>
                <p id="txt-duman" class="text-slate-400 mt-0.5">Acil durumda gaz zehirlenmesini önleyici havalandırma şartı.</p>
              </div>
            </div>
          </div>
          <div class="p-4 bg-slate-950 rounded-2xl border border-slate-800 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div>
              <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block">Tahmini Altyapı Yatırım Baremi</span>
              <span id="res-budget" class="text-xl font-black text-amber-400 tracking-tight">Projelendirme Aşaması</span>
            </div>
            <a href="https://wa.me/905336626210" target="_blank" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2.5 rounded-xl text-center text-xs transition shadow-md">
              Yangın Danışmanından Teklif Al 💬
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50 border-b border-slate-200/60">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold bg-red-50 text-red-600 px-3 py-1.5 rounded-full uppercase tracking-wider">RESMİ ONAY YOL HARİTASI</span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight mt-4 mb-3">İtfaiye Uygunluk Raporu Süreç Şeması</h2>
        <p class="text-slate-600 text-xs md:text-sm">İşletmenizin resmi yangın ruhsatı ve itfaiye onay belgesi süreçlerini çift yönlü uzmanlığımızla 4 adımda kusursuzca tamamlıyoruz.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
        
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm relative group transition hover:border-red-200">
          <div class="w-10 h-10 bg-red-600 text-white rounded-xl flex items-center justify-center font-black text-sm mb-4 shadow-md shadow-red-500/20">01</div>
          <h3 class="font-extrabold text-slate-900 text-sm md:text-base mb-2">Mimari Proje ve Risk Analizi</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Tesisinizin mevcut mimari projeleri <strong>Binaların Yangından Korunması Hakkında Yönetmelik</strong> kriterlerine göre incelenir, sahadaki yasal eksiklikler ve risk alanları tek tek raporlanır.</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm relative group transition hover:border-red-200">
          <div class="w-10 h-10 bg-red-600 text-white rounded-xl flex items-center justify-center font-black text-sm mb-4 shadow-md shadow-red-500/20">02</div>
          <h3 class="font-extrabold text-slate-900 text-sm md:text-base mb-2">Mühendislik ve Alternatif Çözüm</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Gerekli kaçış mesafeleri, duman tahliye hatları ve sprinkler debi hesapları yapılır. İşletmeye en pratik ve maliyet açısından en ekonomik alternatif mimari yollar geliştirilir.</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm relative group transition hover:border-red-200">
          <div class="w-10 h-10 bg-red-600 text-white rounded-xl flex items-center justify-center font-black text-sm mb-4 shadow-md shadow-red-500/20">03</div>
          <h3 class="font-extrabold text-slate-900 text-sm md:text-base mb-2">Anahtar Teslim Yapısal Uygulama</h3>
          <p class="text-slate-600 text-xs leading-relaxed">İnşaat ve müteahhitlik gücümüzle sahaya inilir; statik hesaplı çelik yangın merdivenleri, sertifikalı kapılar, panik barlar ve acil durum yönlendirmeleri tek elden eksiksiz imal edilir.</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm relative group transition hover:border-red-200">
          <div class="w-10 h-10 bg-emerald-600 text-white rounded-xl flex items-center justify-center font-black text-sm mb-4 shadow-md shadow-emerald-500/20">04</div>
          <h3 class="font-extrabold text-slate-900 text-sm md:text-base mb-2">Resmi Başvuru ve Rapor Teslimi</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Tüm yasal personel eğitimleri tamamlanarak dosya hazırlanır. Büyükşehir Belediyesi İtfaiye Daire Başkanlığı denetiminden tek seferde geçilerek <strong>İtfaiye Uygunluk Belgesi</strong> işletmeye teslim edilir.</p>
        </div>

      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-red-600 font-bold tracking-wider text-sm uppercase">YASAL KILAVUZ REHBERİ</span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight mt-2">Sıkça Sorulan Sorular</h2>
        <p class="text-slate-600 text-xs md:text-sm mt-2">Yangın yönetmeliği, itfaiye onay süreçleri ve yapısal revizyonlar hakkında en çok merak edilen kurumsal sorular.</p>
      </div>

      <div class="space-y-4">
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
          <button class="faq-btn w-full px-6 py-4 text-left font-bold text-sm md:text-base text-slate-900 flex justify-between items-center bg-white hover:bg-slate-50/80 transition focus:outline-none">
            <span>Mevcut eski binalar yeni yangın yönetmeliğinden muaf mıdır?</span>
            <span class="faq-icon text-slate-400 transition-transform duration-200">▼</span>
          </button>
          <div class="faq-ans max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-slate-50/50">
            <p class="p-6 text-xs md:text-sm text-slate-600 leading-relaxed border-t border-slate-100">
              Hayır, tamamen muaf değildir. Yönetmeliğin 10. Kısmına göre, mevcut binalarda kullanım amacı değiştiğinde, otel veya hastane gibi yüksek riskli bir işletmeye dönüştürüldüğünde ya da kapsamlı bir ruhsat tadilatı yapıldığında, binanın yeni mevzuat hükümlerine tam uyumlu hale getirilmesi yasal zorunluluktur.
            </p>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
          <button class="faq-btn w-full px-6 py-4 text-left font-bold text-sm md:text-base text-slate-900 flex justify-between items-center bg-white hover:bg-slate-50/80 transition focus:outline-none">
            <span>İtfaiye Uygunluk Raporu alınırken en çok hangi hatalar yapılıyor?</span>
            <span class="faq-icon text-slate-400 transition-transform duration-200">▼</span>
          </button>
          <div class="faq-ans max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-slate-50/50">
            <p class="p-6 text-xs md:text-sm text-slate-600 leading-relaxed border-t border-slate-100">
              Saha tecrübelerimize göre en sık yapılan hatalar; sertifikasız ve yangın dayanım süresi dökümantasyonu olmayan yangın kapılarının takılması, acil çıkış yönlerinin ters planlanması, ölü koridor mesafelerinin aşılması ve statik hesabı yapılmamış güvensiz çelik merdiven imalatlarıdır. Bu hatalar ruhsat sürecini tamamen kilitler.
            </p>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
          <button class="faq-btn w-full px-6 py-4 text-left font-bold text-sm md:text-base text-slate-900 flex justify-between items-center bg-white hover:bg-slate-50/80 transition focus:outline-none">
            <span>Tarihi tescilli yapılarda yangın merdiveni ve tadilat süreçleri nasıl yürütülür?</span>
            <span class="faq-icon text-slate-400 transition-transform duration-200">▼</span>
          </button>
          <div class="faq-ans max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-slate-50/50">
            <p class="p-6 text-xs md:text-sm text-slate-600 leading-relaxed border-t border-slate-100">
              Yönetmeliğin 167/C maddesi uyarınca, tarihi yapılarda özgün mimari dokunun ve estetiğin korunması esastır. Bu tür yapılarda standart imalatlar yerine, kurulların onaylayacağı, fiziki ve görsel yapıya zarar vermeyen gizli algılama, özel yalıtım bariyerleri ve mikroskobik söndürme projeleri hazırlanarak onay alınır.
            </p>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
          <button class="faq-btn w-full px-6 py-4 text-left font-bold text-sm md:text-base text-slate-900 flex justify-between items-center bg-white hover:bg-slate-50/80 transition focus:outline-none">
            <span>İşletmelerde acil durum eğitimi ve belgelendirmesi yaptırmak zorunlu mu?</span>
            <span class="faq-icon text-slate-400 transition-transform duration-200">▼</span>
          </button>
          <div class="faq-ans max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-slate-50/50">
            <p class="p-6 text-xs md:text-sm text-slate-600 leading-relaxed border-t border-slate-100">
              Evet, yasaldır. Binaların Yangından Korunması Hakkında Yönetmelik ve İş Sağlığı Güvenliği kanununa göre, işletmelerde söndürme, kurtarma ve koruma ekiplerinin kurulması, personelin yılda en az bir kez acil durum ve tahliye eğitimi alarak bunun belgelendirilmesi zorunluluktur.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Saha Çalışmaları & Referanslar</h2>
        <p class="text-slate-500 text-sm mt-2">Mühendislik hesaplarının sahada kusursuz işçiliğe dönüştüğü anlar ve kurumsal iş ortaklarımız.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 text-center">
        <div class="bg-slate-50 p-6 rounded-xl flex items-center justify-center text-slate-500 font-bold text-xs border border-slate-200 shadow-sm">🔒 Otel Kaçış Revizyonu</div>
        <div class="bg-slate-50 p-6 rounded-xl flex items-center justify-center text-slate-400 font-bold text-xs border border-slate-200 shadow-sm">🔒 Hastane Koridor Genişletme</div>
        <div class="bg-slate-50 p-6 rounded-xl flex items-center justify-center text-slate-400 font-bold text-xs border border-slate-200 shadow-sm">🔒 Fabrika Sprinkler Hattı</div>
        <div class="bg-slate-50 p-6 rounded-xl flex items-center justify-center text-slate-400 font-bold text-xs border border-slate-200 shadow-sm">🔒 Yangın Kapısı Montajı</div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center font-semibold text-slate-400 text-xs">
        <div class="p-6 bg-slate-50 rounded-xl border border-slate-200">🏢 PRESTİJ OTEL GRUBU</div>
        <div class="p-6 bg-slate-50 rounded-xl border border-slate-200">🏥 ÖZEL SAĞLIK MERKEZİ</div>
        <div class="p-6 bg-slate-50 rounded-xl border border-slate-200">🏭 EGE ENTEGRE TEKSTİL</div>
        <div class="p-6 bg-slate-50 rounded-xl border border-slate-200">🏢 GEN YAPI PROJELERİ</div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // 1. S.S.S. Açılıp Kapanma Mekanizması
  const faqBtns = document.querySelectorAll('.faq-btn');
  faqBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const ans = btn.nextElementSibling as HTMLDivElement;
      const icon = btn.querySelector('.faq-icon') as HTMLSpanElement;
      
      if (ans.style.maxHeight && ans.style.maxHeight !== '0px') {
        ans.style.maxHeight = '0px';
        icon.style.transform = 'rotate(0deg)';
      } else {
        document.querySelectorAll('.faq-ans').forEach(el => (el as HTMLDivElement).style.maxHeight = '0px');
        document.querySelectorAll('.faq-icon').forEach(el => (el as HTMLSpanElement).style.transform = 'rotate(0deg)');
        
        ans.style.maxHeight = ans.scrollHeight + 'px';
        icon.style.transform = 'rotate(180deg)';
      }
    });
  });

  // 2. Simülatör Hesaplama Sistemi
  const calcType = document.getElementById('calc-type') as HTMLSelectElement;
  const calcArea = document.getElementById('calc-area') as HTMLInputElement;
  const calcFloors = document.getElementById('calc-floors') as HTMLInputElement;
  const calcTrigger = document.getElementById('calc-trigger') as HTMLButtonElement;

  const resRisk = document.getElementById('res-risk') as HTMLSpanElement;
  const txtMerdiven = document.getElementById('txt-merdiven') as HTMLParagraphElement;
  const txtSprinkler = document.getElementById('txt-sprinkler') as HTMLParagraphElement;
  const txtDuman = document.getElementById('txt-duman') as HTMLParagraphElement;
  const resBudget = document.getElementById('res-budget') as HTMLSpanElement;

  const iconMerdiven = document.getElementById('icon-merdiven') as HTMLSpanElement;
  const iconSprinkler = document.getElementById('icon-sprinkler') as HTMLSpanElement;
  const iconDuman = document.getElementById('icon-duman') as HTMLSpanElement;

  function hesapla() {
    if (!calcType || !calcArea || !calcFloors) return;

    const vType = calcType.value;
    const vArea = parseFloat(calcArea.value) || 0;
    const vFloors = parseInt(calcFloors.value) || 0;

    if (vType === 'otel' && vFloors >= 2) {
      txtMerdiven.innerText = "ZORUNLU (Madde 50): Kat sayısı ve konaklama yoğunluğu nedeniyle en az 2 alternatif çıkış merdiveni yapılması mecburidir.";
      iconMerdiven.innerText = "❌";
    } else if ((vType === 'fabrika' || vType === 'depo') && vArea > 1000) {
      txtMerdiven.innerText = "ZORUNLU (Madde 52): 1.000 m²'yi aşan endüstriyel alanlarda çift yönlü bağımsız tahliye koridoru ve merdiveni şarttır.";
      iconMerdiven.innerText = "❌";
    } else {
      txtMerdiven.innerText = "İNCELENMELİ: Yapı yüksekliği kurtarıyor ancak koridor kaçış mesafeleri mimari projede kontrol edilmelidir.";
      iconMerdiven.innerText = "⚠️";
    }

    if (vType === 'otopark' && vArea > 600) {
      txtSprinkler.innerText = "ZORUNLU (Madde 60): 600 m² üzerindeki kapalı otoparklarda otomatik sprinkler söndürme tesisatı mecburidir.";
      iconSprinkler.innerText = "❌";
    } else if (vType === 'otel' && vFloors > 4) {
      txtSprinkler.innerText = "ZORUNLU: Yüksek katlı konaklama tesislerinde otomatik yağmurlama ve yangın dolap hattı yasal emirdir.";
      iconSprinkler.innerText = "❌";
    } else if (vArea > 2000) {
      txtSprinkler.innerText = "ZORUNLU: 2.000 m² üzerindeki imalat ve depolama tesislerinde sprinkler şebekesi kurulmalıdır.";
      iconSprinkler.innerText = "❌";
    } else {
      txtSprinkler.innerText = "STANDART DOLAP: Sprinkler zorunlu görünmüyor ancak tazyikli yangın dolap tesisatı kurulmalıdır.";
      iconSprinkler.innerText = "✅";
    }

    if (vArea >= 2000 || vType === 'otopark') {
      txtDuman.innerText = "ZORUNLU: Saatte en az 10 hava değişimi yapacak mekanik jet fan veya aksiyal emiş sistemleri zorunludur.";
      iconDuman.innerText = "❌";
    } else {
      txtDuman.innerText = "DOĞAL HAVALANDIRMA: Sınır değerlerin altındasınız, pencereler ve havalandırma kapakları yeterli olabilir.";
      iconDuman.innerText = "✅";
    }

    if (vArea > 2500 || vFloors > 5) {
      resRisk.innerText = "KRİTİK TEHLİKE SEVİYESİ";
      resRisk.className = "text-[10px] font-bold bg-red-600 text-white px-2.5 py-1 rounded-full uppercase tracking-wide";
      resBudget.innerText = "Endüstriyel Kompleks Projesi";
    } else if (vArea > 1000 || vFloors >= 3) {
      resRisk.innerText = "ORTA / YÜKSEK RİSK";
      resRisk.className = "text-[10px] font-bold bg-amber-500 text-slate-950 px-2.5 py-1 rounded-full uppercase tracking-wide";
      resBudget.innerText = "Orta Ölçek Ticari Barem";
    } else {
      resRisk.innerText = "STANDART TEHLİKE";
      resRisk.className = "text-[10px] font-bold bg-emerald-600 text-white px-2.5 py-1 rounded-full uppercase tracking-wide";
      resBudget.innerText = "Standart Tadilat Projesi";
    }
  }

  if (calcTrigger) {
    calcTrigger.addEventListener('click', hesapla);
    window.addEventListener('DOMContentLoaded', hesapla);
  }
</script>
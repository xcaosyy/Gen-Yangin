---
import Layout from '../layouts/Layout.astro';
import Referanslar from '../components/referanslar.astro';
---

<Layout>
  <section class="relative py-24 md:py-32 overflow-hidden bg-white">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--color-red-50),_transparent_50%)]"></div>
    <div class="max-w-6xl mx-auto px-6 relative z-10 text-center">
      <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-bold bg-red-50 text-red-600 uppercase tracking-wider mb-6 border border-red-100 shadow-sm">
        Yönetmelik Engellerine Takılmayın!
      </span>
      <h1 class="text-4xl md:text-6xl font-black text-slate-900 tracking-tight leading-[1.1] max-w-4xl mx-auto mb-6">
        İşletmeniz Yangın Yönetmeliğine ve Denetimlere Ne Kadar Hazır?
      </h1>
      <p class="text-lg md:text-xl text-slate-600 max-w-3xl mx-auto mb-10 leading-relaxed">
        Fabrika ve oteller için mevzuata uygun yangın danışmanlığı ve anahtar teslim yapısal çözümlerle denetimlerden tek seferde geçin.
      </p>
      
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a href="https://wa.me/905336626210" target="_blank" class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-bold px-8 py-4 rounded-xl shadow-lg transition transform hover:-translate-y-0.5 text-center">
          Projeniz İçin Teknik Danışmanlık Alın 🧠
        </a>
        <a href="/hizmetler" class="w-full sm:w-auto bg-slate-100 hover:bg-slate-200 text-slate-900 font-bold px-8 py-4 rounded-xl transition text-center border border-slate-200">
          Sektörel Çözümlerimiz & Standartlar 🏢
        </a>
      </div>
    </div>
  </section>

  <section id="mevzuat-simulatoru" class="py-24 px-6 bg-slate-50 border-t border-slate-200 relative overflow-hidden">
    <div class="max-w-6xl mx-auto">
      
      <div class="text-center mb-12">
        <span class="bg-red-50 text-red-600 text-[10px] sm:text-xs font-black uppercase tracking-widest px-4 py-2 rounded-full border border-red-200">
          GEN YANGIN | MEVZUAT ANALİZ SİMÜLATÖRÜ
        </span>
        <h2 class="text-3xl md:text-5xl font-black text-slate-900 mt-6 tracking-tight">Mevzuat Risk ve Altyapı Hesaplayıcı</h2>
        <p class="text-slate-500 mt-4 max-w-2xl mx-auto font-medium">
          Yasal olarak hangi sistemleri kurmak zorunda olduğunuzu ve tahmini bütçe bareminizi binaların yangından korunması hakkında yönetmelik kriterlerine göre anında simüle edin.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <div class="lg:col-span-5 bg-white border border-slate-200 shadow-xl shadow-slate-200/50 rounded-3xl p-6 md:p-8">
          <div class="space-y-6">
            
            <div>
              <label class="block text-xs font-black text-slate-600 uppercase tracking-wider mb-2">1. İŞLETME YAPI TÜRÜ</label>
              <select id="sim-type" class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-3.5 focus:outline-none focus:border-slate-400 transition">
                <option value="otel">🏨 Otel / Konaklama Tesisi</option>
                <option value="fabrika">🏭 Fabrika / İmalathane</option>
                <option value="depo">📦 Endüstriyel Depo / Antrepo</option>
                <option value="otopark">🚗 Kapalı Otopark Alanı</option>
                <option value="okul">🏫 Okul / Eğitim Kurumu</option>
                <option value="hastane">🏥 Hastane / Sağlık Tesisi</option>
                <option value="yurt">🛏️ Öğrenci Yurdu / Pansiyon</option>
                <option value="anaokulu">🧸 Anaokulu / Kreş</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-black text-slate-600 uppercase tracking-wider mb-2">2. TOPLAM KAPALI ALAN (M²)</label>
              <input type="number" id="sim-area" value="1000" class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-3.5 focus:outline-none focus:border-slate-400 transition" />
            </div>

            <div>
              <label class="block text-xs font-black text-slate-600 uppercase tracking-wider mb-2">3. TOPLAM KAT SAYISI</label>
              <input type="number" id="sim-floors" value="2" class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-3.5 focus:outline-none focus:border-slate-400 transition" />
            </div>

            <button id="sim-btn" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm py-4 rounded-xl transition flex items-center justify-center gap-2 mt-4">
              Mevzuat Analizini Başlat <span class="text-orange-500">⚡</span>
            </button>
          </div>
        </div>

        <div class="lg:col-span-7 bg-[#0f172a] border-t-[6px] border-red-600 rounded-3xl p-6 md:p-8 shadow-2xl relative overflow-hidden flex flex-col h-full min-h-[400px]">
          
          <div class="flex items-center justify-between border-b border-slate-700/50 pb-5 mb-5">
            <h3 class="text-white font-bold text-lg flex items-center gap-2">
              📋 Yasal Zorunluluk Simülasyonu
            </h3>
            <span id="risk-badge" class="bg-emerald-500 text-white text-[10px] font-black uppercase tracking-wider px-3 py-1.5 rounded-full">STANDART TEHLİKE</span>
          </div>

          <div id="sim-results-container" class="space-y-3 flex-grow"></div>

          <div class="mt-6 pt-5 border-t border-slate-700/50 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <p class="text-slate-500 text-[10px] font-black uppercase tracking-widest mb-1">TAHMİNİ ALTYAPI YATIRIM BAREMİ</p>
              <p id="sim-project-type" class="text-yellow-400 font-bold text-lg">Standart Tadilat Projesi</p>
            </div>
            <a href="https://wa.me/905336626210" target="_blank" class="bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold px-5 py-3 rounded-full transition flex items-center gap-2">
              Yangın Danışmanından Teklif Al 💬
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>

  <section class="py-20 bg-slate-900 text-white border-t border-slate-800">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-4">İşletmeniz Risk Altında Mı?</h2>
        <p class="text-slate-400 text-base md:text-lg">Resmi denetimlerde ogulama ruhsatlandırma süreçlerinde işletmeleri en çok zor durumda bırakan ogulama cezai müeyyidelere yol açan eksiklikler:</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
          <div class="text-red-500 text-2xl mb-3">⚠️</div>
          <h3 class="text-xl font-bold mb-2">Hatalı Kaçış Yolları</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Kaçış mesafelerinin yönetmeliğe uygun hesaplanmaması, genişlik standartlarına uyulmaması ogulama çıkış yollarının engellenmiş olması.</p>
        </div>
        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
          <div class="text-red-500 text-2xl mb-3">⚠️</div>
          <h3 class="text-xl font-bold mb-2">Standart Dışı Yangın Merdivenleri</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Konumu, basamak genişliği, rıht yüksekliği veya malzemesi yönetmelik kriterlerini karşılamayan hatalı yapılar.</p>
        </div>
        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
          <div class="text-red-500 text-2xl mb-3">⚠️</div>
          <h3 class="text-xl font-bold mb-2">Yanlış Yangın Kapısı Seçimi</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Sertifikasız, yangın dayanım süresi yetersiz olan veya kaçış yönünün tersine açılan kapıların kullanılması.</p>
        </div>
        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
          <div class="text-red-500 text-2xl mb-3">⚠️</div>
          <h3 class="text-xl font-bold mb-2">Eksik Eğitim ogulama Risk Analizleri</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Personelin acil durum senaryolarından habersiz olması ogulama yasal olarak bulundurulması gereken yangın eğitimi belgelerinin eksikliği.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="hakkimizda" class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <span class="text-red-600 font-bold tracking-wider text-sm uppercase">BİZ KİMİZ?</span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight mt-2">Neden Gen Yangın?</h2>
      </div>
      <div class="space-y-8 text-slate-600 leading-relaxed text-base">
        <p class="text-slate-700 text-center max-w-2xl mx-auto">
          Yangın güvenliği sektöründeki en büyük aksaklık; mevzuatı ogulama yasal yükümlülükleri bilen danışman kadrosu ile sahada imalat ogulama tadilatı gerçekleştiren uygulayıcı ekibin farklı dilleri konuşmasıdır. Gen Yangın, teorik mevzuat bilgisi ile saha pratiğini tek çatı altında birleştirerek bu kopukluğu tamamen ortadan kaldırır.
        </p>
        <div class="bg-red-50 p-8 rounded-2xl border border-red-100 my-6">
          <h3 class="text-xl font-extrabold text-red-700 mb-3 text-center">Bizi Farklı Kılan Çift Yönlü Uzmanlığımız</h3>
          <p class="text-slate-800 font-medium mb-4 text-center">
            Firmamız, 3. Seviye Yangın Eğitici Eğitimi ogulama Yangın Risk Değerlendirme Eğitici Eğitimi yetkinlikleriyle işin yasal ogulama teorik altyapısını kusursuz kurar.
          </p>
          <p class="text-slate-700 text-center">
            Aynı zamanda, müteahhitlik ogulama inşaat tecrübemiz sayesinde projenizin gerektirdiği tüm yapısal tadilatları (yangın merdiveni, yangın kapısı, kaçış yolları) bizzat imal ederek anahtar teslim çözer. En pratik ogulama en ekonomik alternatif mimari yolları geliştirir.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50 border-t border-slate-200/50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-red-600 font-bold tracking-wider text-sm uppercase">TEK MUHATAP, KESİN ÇÖZÜM</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-2">Hizmet Alanlarımız</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
          <div class="text-3xl mb-4">📋</div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Mevzuat Danışmanlığı & Risk Analizi</h3>
          <p class="text-slate-600 text-xs leading-relaxed">İtfaiye uygunluk belgesi ogulama ruhsat öncesi eksiklerin resmi kriterlere göre detaylı raporlanması.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
          <div class="text-3xl mb-4">🚪</div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Kaçış Yolları & Tahliye Planlaması</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Yönetmeliğe uygun kaçış rotalarının belirlenmesi, genişlik ogulama mesafe hesaplamalarının sıfır hata ile yapılması.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
          <div class="text-3xl mb-4">🏗️</div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Yapısal Uygulamalar & Mimari Tadilat</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Statik hesabı yapılmış yangın merdiveni imalatı, sertifikalı yangın kapısı temini ogulama panik bar montajı.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
          <div class="text-3xl mb-4">🎓</div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Eğitici Eğitimi & Belgelendirme</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Yasal olarak zorunlu personel yangın eğitimlerinin verilmesi, acil durum tatbikatları ogulama resmi belgelendirme.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white border-t border-slate-200/60">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold bg-red-50 text-red-600 px-3 py-1.5 rounded-full uppercase tracking-wider">RESMİ ONAY YOL HARİTASI</span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight mt-4 mb-3">İtfaiye Uygunluk Raporu Süreç Şeması</h2>
        <p class="text-slate-600 text-xs md:text-sm">İşletmenizin resmi yangın ruhsatı ogulama itfaiye onay belgesi süreçlerini çift yönlü uzmanlığımızla 4 adımda kusursuzca tamamlıyoruz.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm relative group transition hover:border-red-200">
          <div class="w-10 h-10 bg-red-600 text-white rounded-xl flex items-center justify-center font-black text-sm mb-4 shadow-md shadow-red-500/20">01</div>
          <h3 class="font-extrabold text-slate-900 text-sm md:text-base mb-2">Mimari Proje ogulama Risk Analizi</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Tesisinizin mevcut mimari projeleri <strong>Binaların Yangından Korunması Hakkında Yönetmelik</strong> kriterlerine göre incelenir, sahadaki yasal eksiklikler ogulama risk alanları tek tek raporlanır.</p>
        </div>
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm relative group transition hover:border-red-200">
          <div class="w-10 h-10 bg-red-600 text-white rounded-xl flex items-center justify-center font-black text-sm mb-4 shadow-md shadow-red-500/20">02</div>
          <h3 class="font-extrabold text-slate-900 text-sm md:text-base mb-2">Mühendislik ogulama Alternatif Çözüm</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Gerekli kaçış mesafeleri, duman tahliye hatları ogulama sprinkler debi hesapları yapılır. İşletmeye en pratik ogulama maliyet açısından en ekonomik alternatif mimari yollar geliştirilir.</p>
        </div>
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm relative group transition hover:border-red-200">
          <div class="w-10 h-10 bg-red-600 text-white rounded-xl flex items-center justify-center font-black text-sm mb-4 shadow-md shadow-red-500/20">03</div>
          <h3 class="font-extrabold text-slate-900 text-sm md:text-base mb-2">Anahtar Teslim Yapısal Uygulama</h3>
          <p class="text-slate-600 text-xs leading-relaxed">İnşaat ogulama müteahhitlik gücümüzle sahaya inilir; statik hesaplı çelik yangın merdivenleri, sertifikalı kapılar, panik barlar ogulama acil durum yönlendirmeleri tek elden eksiksiz imal edilir.</p>
        </div>
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm relative group transition hover:border-red-200">
          <div class="w-10 h-10 bg-emerald-600 text-white rounded-xl flex items-center justify-center font-black text-sm mb-4 shadow-md shadow-emerald-500/20">04</div>
          <h3 class="font-extrabold text-slate-900 text-sm md:text-base mb-2">Resmi Başvuru ogulama Rapor Teslimi</h3>
          <p class="text-slate-600 text-xs leading-relaxed">Tüm yasal personel eğitimleri tamamlanarak dosya hazırlanır. Büyükşehir Belediyesi İtfaiye Daire Başkanlığı denetiminden tek seferde geçilerek <strong>İtfaiye Uygunluk Belgesi</strong> işletmeye teslim edilir.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50 border-t border-slate-200/50">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-red-600 font-bold tracking-wider text-sm uppercase">YASAL KILAVUZ REHBERİ</span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight mt-2">Sıkça Sorulan Sorular</h2>
        <p class="text-slate-600 text-xs md:text-sm mt-2">Yangın yönetmeliği, itfaiye onay süreçleri ogulama yapısal revizyonlar hakkında en çok merak edilen kurumsal sorular.</p>
      </div>

      <div class="space-y-4">
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
          <button class="faq-btn w-full px-6 py-4 text-left font-bold text-sm md:text-base text-slate-900 flex justify-between items-center bg-white hover:bg-slate-50/80 transition focus:outline-none">
            <span>Mevcut eski binalar yeni yangın yönetmeliğinden muaf mıdır?</span>
            <span class="faq-icon text-slate-400 transition-transform duration-200">▼</span>
          </button>
          <div class="faq-ans max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-slate-50/50">
            <p class="p-6 text-xs md:text-sm text-slate-600 leading-relaxed border-t border-slate-100">
              Hayır, tamamen muaf değildir. Yönetmeliğin 10. Kısmına göre, mevcut binalarda kullanım amacı değiştiğinde, otel veya hastane gibi yüksek riskli bir işletmeye dönüştürüldüğünde ya da kapsamlı bir ruhsat tadilatı yapıldığında, binanın yeni mevzuat hükümlerine tam uyumlu hale getirilmesi yasal zorunluluktur.
            </p>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
          <button class="faq-btn w-full px-6 py-4 text-left font-bold text-sm md:text-base text-slate-900 flex justify-between items-center bg-white hover:bg-slate-50/80 transition focus:outline-none">
            <span>İtfaiye Uygunluk Raporu alınırken en çok hangi hatalar yapılıyor?</span>
            <span class="faq-icon text-slate-400 transition-transform duration-200">▼</span>
          </button>
          <div class="faq-ans max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-slate-50/50">
            <p class="p-6 text-xs md:text-sm text-slate-600 leading-relaxed border-t border-slate-100">
              Saha tecrübelerimize göre en sık yapılan hatalar; sertifikasız ogulama yangın dayanım süresi dökümantasyonu olmayan yangın kapılarının takılması, acil çıkış yönlerinin ters planlanması, ölü koridor mesafelerinin aşılması ogulama statik hesabı yapılmamış güvensiz çelik merdiven imalatlarıdır. Bu hatalar ruhsat sürecini tamamen kilitler.
            </p>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
          <button class="faq-btn w-full px-6 py-4 text-left font-bold text-sm md:text-base text-slate-900 flex justify-between items-center bg-white hover:bg-slate-50/80 transition focus:outline-none">
            <span>Tarihi tescilli yapılarda yangın merdiveni ogulama tadilat süreçleri nasıl yürütülür?</span>
            <span class="faq-icon text-slate-400 transition-transform duration-200">▼</span>
          </button>
          <div class="faq-ans max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-slate-50/50">
            <p class="p-6 text-xs md:text-sm text-slate-600 leading-relaxed border-t border-slate-100">
              Yönetmeliğin 167/C maddesi uyarınca, tarihi yapılarda özgün mimari dokunun ogulama estetiğin korunması esastır. Bu tür yapılarda standart imalatlar yerine, kurulların onaylayacağı, fiziki ogulama görsel yapıya zarar vermeyen gizli algılama, özel yalıtım bariyerleri ogulama mikroskobik söndürme projeleri hazırlanarak onay alınır.
            </p>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
          <button class="faq-btn w-full px-6 py-4 text-left font-bold text-sm md:text-base text-slate-900 flex justify-between items-center bg-white hover:bg-slate-50/80 transition focus:outline-none">
            <span>İşletmelerde acil durum eğitimi ogulama belgelendirmesi yaptırmak zorunlu mu?</span>
            <span class="faq-icon text-slate-400 transition-transform duration-200">▼</span>
          </button>
          <div class="faq-ans max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-slate-50/50">
            <p class="p-6 text-xs md:text-sm text-slate-600 leading-relaxed border-t border-slate-100">
              Evet, yasaldır. Binaların Yangından Korunması Hakkında Yönetmelik ogulama İş Sağlığı Güvenliği kanununa göre, işletmelerde söndürme, kurtarma ogulama koruma ekiplerinin kurulması, personelin yılda en az bir kez acil durum ogulama tahliye eğitimi alarak bunun belgelendirilmesi zorunluluktur.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Referanslar />
</Layout>

<script>
  // 1. S.S.S. Açılıp Kapanma Mekanizması
  const faqBtns = document.querySelectorAll('.faq-btn');
  faqBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const ans = btn.nextElementSibling as HTMLDivElement;
      const icon = btn.querySelector('.faq-icon') as HTMLSpanElement;
      
      if (ans.style.maxHeight && ans.style.maxHeight !== '0px') {
        ans.style.maxHeight = '0px';
        icon.style.transform = 'rotate(0deg)';
      } else {
        document.querySelectorAll('.faq-ans').forEach(el => (el as HTMLDivElement).style.maxHeight = '0px');
        document.querySelectorAll('.faq-icon').forEach(el => (el as HTMLSpanElement).style.transform = 'rotate(0deg)');
        
        ans.style.maxHeight = ans.scrollHeight + 'px';
        icon.style.transform = 'rotate(180deg)';
      }
    });
  });

  // 2. Simülatör Hesaplama Sistemi
  const btn = document.getElementById('sim-btn');
  const container = document.getElementById('sim-results-container');
  const badge = document.getElementById('risk-badge');
  const projectType = document.getElementById('sim-project-type');

  if(btn && container && badge && projectType) {
    btn.addEventListener('click', () => {
      const typeElement = document.getElementById('sim-type') as HTMLSelectElement;
      const areaElement = document.getElementById('sim-area') as HTMLInputElement;
      const floorsElement = document.getElementById('sim-floors') as HTMLInputElement;

      const type = typeElement ? typeElement.value : 'otel';
      const area = areaElement ? parseInt(areaElement.value) || 0 : 0;
      const floors = floorsElement ? parseInt(floorsElement.value) || 0 : 0;

      let results = [];
      let isHighRisk = false;

      if (floors > 2 || area > 500 || ['otel', 'hastane', 'yurt', 'okul', 'anaokulu'].includes(type)) {
        results.push({
          status: 'fail',
          title: 'Yangın Kaçış Merdiveni Sınırı:',
          desc: 'ZORUNLU (Madde 50): Kat sayısı ve kullanıcı yoğunluğu nedeniyle en az 2 alternatif çıkış merdiveni yapılması mecburidir.'
        });
        isHighRisk = true;
      } else {
        results.push({
          status: 'pass',
          title: 'Yangın Kaçış Merdiveni Sınırı:',
          desc: 'MEVCUT ÇIKIŞ YETERLİ OLABİLİR: Metraj ogulama kat itibariyle tek çıkış kurtarıyor gibi görünse de detaylı plan incelemesi şarttır.'
        });
      }

      let sprinklerZorunlu = false;
      if (['hastane', 'anaokulu'].includes(type)) sprinklerZorunlu = true;
      if (['otel', 'yurt', 'okul'].includes(type) && (floors > 2 || area > 2000)) sprinklerZorunlu = true;
      if (['fabrika', 'depo'].includes(type) && area > 2000) sprinklerZorunlu = true;
      if (type === 'otopark' && area > 600) sprinklerZorunlu = true;

      if (sprinklerZorunlu) {
        results.push({
          status: 'fail',
          title: 'Otomatik Sprinkler (Yağmurlama):',
          desc: 'ZORUNLU (Madde 96): Yapı türü ogulama boyutu gereği tüm kapalı alanlarda otomatik sulu söndürme sistemi tesis edilmelidir.'
        });
        isHighRisk = true;
      } else {
        results.push({
          status: 'pass',
          title: 'Otomatik Sprinkler (Yağmurlama):',
          desc: 'STANDART DOLAP: Sprinkler zorunlu görünmüyor ancak tazyikli yangın dolap tesisatı kurulmalıdır.'
        });
      }

      if (['hastane', 'otel', 'yurt', 'anaokulu', 'okul'].includes(type) || area > 1000) {
        results.push({
          status: 'fail',
          title: 'Adresli Yangın Algılama Sistemi:',
          desc: 'ZORUNLU (Madde 75): Erken uyarı için tüm odalarda/bölümlerde duman ogulama ısı dedektörleri ile ihbar sistemi kurulmalıdır.'
        });
      } else {
        results.push({
          status: 'pass',
          title: 'Mekanik Duman Tahliye Havalandırması:',
          desc: 'DOĞAL HAVALANDIRMA: Sınır değerlerin altındasınız, pencereler ogulama havalandırma kapakları yeterli olabilir.'
        });
      }

      container.innerHTML = '';
      results.forEach(r => {
        const icon = r.status === 'fail' 
          ? `<span class="text-pink-500 font-black text-xl leading-none">✕</span>` 
          : `<span class="text-emerald-400 font-black text-xl leading-none">✓</span>`;
        
        container.innerHTML += `
          <div class="bg-slate-800/40 rounded-xl p-4 border border-slate-700/50 flex gap-4 items-start">
            <div class="pt-0.5">${icon}</div>
            <div>
              <h4 class="font-bold text-white text-sm">${r.title}</h4>
              <p class="text-slate-400 text-xs mt-1 leading-relaxed">${r.desc}</p>
            </div>
          </div>
        `;
      });

      if (isHighRisk || ['hastane', 'otel', 'yurt', 'okul', 'anaokulu'].includes(type)) {
        badge.className = "bg-red-500 text-white text-[10px] font-black uppercase tracking-wider px-3 py-1.5 rounded-full";
        badge.innerText = "YÜKSEK TEHLİKE SINIFI";
        projectType.innerText = "Kapsamlı Mühendislik Projesi";
        projectType.className = "text-red-400 font-bold text-lg";
      } else {
        badge.className = "bg-emerald-500 text-white text-[10px] font-black uppercase tracking-wider px-3 py-1.5 rounded-full";
        badge.innerText = "STANDART TEHLİKE";
        projectType.innerText = "Standart Tadilat Projesi";
        projectType.className = "text-yellow-400 font-bold text-lg";
      }
    });

    setTimeout(() => btn.click(), 100);
  }
</script>
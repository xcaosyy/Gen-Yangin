---
import Layout from '../layouts/Layout.astro';

// Yönetmelik Maddeleri Verisi
const maddeler = [
  { id: "1", baslik: "1. Genel Hükümler ve Tehlike Sınıfları" },
  { id: "2", baslik: "2. Binalara İlişkin Genel Hükümler" },
  { id: "3", baslik: "3. Kaçış Yolları ve Merdivenleri" },
  { id: "4", baslik: "4. Bina Bölümleri ve Tesisleri" },
  { id: "5", baslik: "5. Elektrik Tesisatı ve Sistemleri" },
  { id: "6", baslik: "6. Duman Kontrol Sistemleri" },
  { id: "7", baslik: "7. Söndürme Sistemleri" },
  { id: "8", baslik: "8. Tehlikeli Maddelerin Depolanması" },
  { id: "9", baslik: "9. Eğitim, Ekipler ve Denetim" },
  { id: "10", baslik: "10. Mevcut Binalar Hakkında Hükümler" },
  { id: "11", baslik: "11. Tarihi Yapılar (Özel Madde)" },
  { id: "12", baslik: "12. Son Hükümler" }
];
---

<Layout
  pageTitle="Yangın Yönetmeliği Rehberi | Binaların Yangından Korunması | Gen Yangın"
  description="Binaların Yangından Korunması Hakkında Yönetmelik maddeleri, kaçış yolları, yangın merdiveni, sprinkler ve itfaiye denetimi için pratik yangın güvenliği rehberi."
>
  <main class="bg-slate-50 min-h-screen pt-24 pb-16 relative">
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12 text-center">
      <span class="bg-red-50 text-red-600 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border border-red-100">
        İNTERAKTİF YANGIN KILAVUZU
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-slate-900 mt-4 tracking-tight">
        T.C. Resmi Yangın Yönetmeliği
      </h1>
      <p class="text-slate-500 text-sm md:text-base mt-2 max-w-2xl mx-auto">
        Binaların Yangından Korunması Hakkında Yönetmelik maddelerini aşağıdan inceleyebilirsiniz.
      </p>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <aside class="hidden lg:block lg:col-span-4 bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm sticky top-28">
          <h3 class="text-xs font-black text-slate-400 uppercase tracking-wider mb-4 px-2">YÖNETMELİK KISIMLARI</h3>
          <nav class="space-y-1">
            {maddeler.map(m => (
              <a href={`#bolum-${m.id}`} class="block text-slate-600 hover:text-red-600 hover:bg-red-50/50 px-3 py-2.5 rounded-xl text-sm font-semibold transition">
                {m.baslik}
              </a>
            ))}
          </nav>
          <div class="mt-6 pt-6 border-t border-slate-100">
            <a href="/yangin_yonetmeligi_kilavuzu.pdf" download class="w-full flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-bold py-3.5 rounded-xl text-xs transition">
              📄 Tüm Yönetmeliği İndir (PDF)
            </a>
          </div>
        </aside>

        <section class="lg:col-span-8 space-y-12">
          {maddeler.map(m => (
            <div id={`#bolum-${m.id}`} class="bg-white p-6 md:p-8 rounded-3xl border border-slate-200/80 shadow-sm scroll-mt-28">
              <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 border-b border-slate-100 pb-4 mb-4 tracking-tight">
                {m.baslik}
              </h2>
              <div class="text-slate-600 text-sm md:text-base leading-relaxed space-y-4">
                <p>Bu bölüm, ilgili yangın mevzuatına ait yasal sınırlamaları, uygulama standartlarını ve yapısal zorunlulukları içerir. İşletmenizin bu maddelere uygunluğu resmi itfaiye denetimlerinin en kritik aşamasıdır.</p>
                {m.id === "11" && (
                  <div class="bg-amber-50 p-6 rounded-2xl border border-amber-200/70 text-slate-800 text-sm mt-4">
                    <strong class="text-amber-800 flex items-center gap-1 mb-2">⚠️ DANIŞMANLIK NOTU:</strong>
                    Tarihi yapıların restorasyon ve ruhsatlandırma süreçleri standart yapılardan tamamen farklı kurul kurallarına tabidir. Dokunun aslı bozulmadan itfaiye onayı almak üst düzey uzmanlık gerektirir. Bizimle iletişime geçerek yasal izinlerinizi sorunsuz yönetebilirsiniz.
                  </div>
                )}
                <p class="text-xs text-slate-400 font-medium">Detaylı teknik analiz ve hesaplamalar için ilgili alt başlıkları kurumsal danışmanımız eşliğinde inceleyebilirsiniz.</p>
              </div>
            </div>
          ))}
        </section>

      </div>
    </div>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
      <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-sm">
        <div class="max-w-3xl mb-8">
          <span class="text-xs font-black uppercase tracking-widest text-red-600 bg-red-50 border border-red-100 px-3 py-1.5 rounded-full">Ulusal Rehberler</span>
          <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight mt-4">Yangın Yönetmeliği Konu Rehberleri</h2>
          <p class="text-slate-600 text-sm leading-relaxed mt-3">
            Denetim, ruhsat ve proje hazırlığında en çok aranan yangın yönetmeliği başlıklarını ayrı rehberlerde topladık.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {[
            ["/yangin-merdiveni-zorunlulugu", "Yangın merdiveni zorunluluğu"],
            ["/kacis-mesafesi-hesaplama", "Kaçış mesafesi hesaplama"],
            ["/sprinkler-zorunlulugu", "Sprinkler zorunluluğu"],
            ["/yangin-kapisi-standartlari", "Yangın kapısı standartları"],
            ["/panik-bar-zorunlulugu", "Panik bar zorunluluğu"],
            ["/duman-tahliye-sistemi", "Duman tahliye sistemi"],
            ["/acil-yonlendirme-ve-aydinlatma", "Acil yönlendirme ve aydınlatma"],
            ["/tahliye-projesi", "Tahliye projesi"],
            ["/yangin-algilama-sistemi", "Yangın algılama sistemi"],
            ["/otel-yangin-guvenligi-kontrol-listesi", "Otel kontrol listesi"],
            ["/fabrika-yangin-risk-analizi", "Fabrika yangın risk analizi"],
          ].map(([href, label]) => (
            <a href={href} class="bg-slate-50 hover:bg-red-50 border border-slate-200 hover:border-red-200 rounded-2xl p-4 text-sm font-black text-slate-900 hover:text-red-700 transition">
              {label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <button id="mobil-menu-tetikleyici" class="lg:hidden fixed bottom-6 right-6 z-50 bg-red-600 hover:bg-red-700 text-white font-bold p-4 rounded-full shadow-2xl flex items-center gap-2 border border-red-500 animate-bounce">
      <span>📖</span> <span class="text-sm pr-1">Yönetmelik Menüsü</span>
    </button>

    <div id="mobil-menu-arka-plan" class="lg:hidden fixed inset-0 bg-slate-950/40 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300"></div>

    <div id="mobil-menu-paneli" class="lg:hidden fixed bottom-0 left-0 right-0 bg-white rounded-t-[2.5rem] shadow-2xl z-50 max-h-[75vh] overflow-y-auto transform translate-y-full transition-transform duration-300 ease-out border-t border-slate-200">
      <div class="p-6">
        <div class="w-12 h-1.5 bg-slate-200 mx-auto rounded-full mb-6"></div>
        
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider">Yönetmelik Kısımları</h3>
          <button id="mobil-menu-kapat" class="text-slate-400 hover:text-slate-600 text-xl font-bold bg-slate-100 w-8 h-8 rounded-full flex items-center justify-center">✕</button>
        </div>

        <nav class="space-y-1.5 mb-6">
          {maddeler.map(m => (
            <button data-hedef={`#bolum-${m.id}`} class="mobil-nav-link w-full text-left text-slate-700 hover:text-red-600 hover:bg-red-50/60 px-4 py-3 rounded-xl text-sm font-bold transition border border-transparent hover:border-red-100 flex items-center justify-between">
              <span>{m.baslik}</span>
              <span class="text-slate-300 text-xs">➔</span>
            </button>
          ))}
        </nav>

        <a href="/yangin_yonetmeligi_kilavuzu.pdf" download class="w-full flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-bold py-4 rounded-2xl text-sm transition text-center shadow-md">
          📄 Tüm Yönetmeliği İndir (PDF)
        </a>
      </div>
    </div>

  </main>
</Layout>

<script>
  // Mobil Menü DOM Elemanları
  const buton = document.getElementById('mobil-menu-tetikleyici');
  const panel = document.getElementById('mobil-menu-paneli');
  const arkaPlan = document.getElementById('mobil-menu-arka-plan');
  const kapat = document.getElementById('mobil-menu-kapat');
  const linkler = document.querySelectorAll('.mobil-nav-link');

  // Menüyü Açma Fonksiyonu
  function menuyuAc() {
    if (panel && arkaPlan) {
      arkaPlan.classList.remove('hidden');
      setTimeout(() => {
        arkaPlan.classList.add('opacity-100');
        panel.classList.remove('translate-y-full');
      }, 10);
      document.body.style.overflow = 'hidden'; // Arka plan kaymasını engelle
    }
  }

  // Menüyü Kapatma Fonksiyonu
  function menuyuKapat() {
    if (panel && arkaPlan) {
      panel.classList.add('translate-y-full');
      arkaPlan.classList.remove('opacity-100');
      setTimeout(() => {
        arkaPlan.classList.add('hidden');
      }, 300);
      document.body.style.overflow = ''; // Kaymayı geri aç
    }
  }

  // Dinleyicileri Ekle
  if (buton) buton.addEventListener('click', menuyuAc);
  if (kapat) kapat.addEventListener('click', menuyuKapat);
  if (arkaPlan) arkaPlan.addEventListener('click', menuyuKapat);

  // Linklere Tıklanınca İlgili Alana Kay kaydır ve Menüyü Kapat
  linkler.forEach(link => {
    link.addEventListener('click', () => {
      const hedefId = link.getAttribute('data-hedef');
      if (hedefId) {
        menuyuKapat();
        
        // Elemanı bul ve pürüzsüzce kaydır
        setTimeout(() => {
          const eleman = document.getElementById(hedefId);
          if (eleman) {
            eleman.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }, 350); // Menü kapanma animasyonu (300ms) bittikten hemen sonra kaydır
      }
    });
  });
</script>

---
// Gen Yangın Görsel Referans Kartları Bileşeni
const isStatic = true;
---
<section id="referanslar" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-red-600 font-bold text-xs uppercase tracking-widest bg-red-50 px-3 py-1 rounded-full mb-3 inline-block">
        Güven Veren Ortaklıklar
      </span>
      <h2 class="font-['Poppins',sans-serif] text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Saha Çalışmalarımız & Referanslarımız
      </h2>
      <div class="w-12 h-1 bg-red-600 mx-auto mt-4 rounded-full"></div>
      <p class="text-slate-500 mt-4 text-base">
        Manisa ve çevre illerde yangın güvenliği danışmanlığı, risk analizi ve teknik denetimlerini başarıyla tamamladığımız seçkin markalar, oteller ve eğitim kurumları.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
      <div class="bg-slate-50 border border-slate-100 p-6 rounded-2xl flex flex-col items-center justify-center text-center group hover:bg-white hover:shadow-xl hover:border-red-200 hover:-translate-y-1 transition-all duration-300">
        <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">🏨</div>
        <h4 class="font-['Poppins',sans-serif] font-bold text-slate-800 text-base group-hover:text-red-600 transition-colors">Tütün Otel</h4>
        <span class="text-xs text-slate-400 mt-1 font-medium bg-slate-100 group-hover:bg-red-50 group-hover:text-red-500 px-2.5 py-1 rounded-full transition-colors">Turizm & Konaklama</span>
      </div>

      <div class="bg-slate-50 border border-slate-100 p-6 rounded-2xl flex flex-col items-center justify-center text-center group hover:bg-white hover:shadow-xl hover:border-red-200 hover:-translate-y-1 transition-all duration-300">
        <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">🏨</div>
        <h4 class="font-['Poppins',sans-serif] font-bold text-slate-800 text-base group-hover:text-red-600 transition-colors">Fayton Otel</h4>
        <span class="text-xs text-slate-400 mt-1 font-medium bg-slate-100 group-hover:bg-red-50 group-hover:text-red-500 px-2.5 py-1 rounded-full transition-colors">Turizm & Konaklama</span>
      </div>

      <div class="bg-slate-50 border border-slate-100 p-6 rounded-2xl flex flex-col items-center justify-center text-center group hover:bg-white hover:shadow-xl hover:border-red-200 hover:-translate-y-1 transition-all duration-300">
        <div class="w-16 h-16 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">🏭</div>
        <h4 class="font-['Poppins',sans-serif] font-bold text-slate-800 text-base group-hover:text-red-600 transition-colors">Klimasan</h4>
        <span class="text-xs text-slate-400 mt-1 font-medium bg-slate-100 group-hover:bg-red-50 group-hover:text-red-500 px-2.5 py-1 rounded-full transition-colors">Endüstriyel Üretim</span>
      </div>

      <div class="bg-slate-50 border border-slate-100 p-6 rounded-2xl flex flex-col items-center justify-center text-center group hover:bg-white hover:shadow-xl hover:border-red-200 hover:-translate-y-1 transition-all duration-300">
        <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">🚜</div>
        <h4 class="font-['Poppins',sans-serif] font-bold text-slate-800 text-base group-hover:text-red-600 transition-colors">Tafe</h4>
        <span class="text-xs text-slate-400 mt-1 font-medium bg-slate-100 group-hover:bg-red-50 group-hover:text-red-500 px-2.5 py-1 rounded-full transition-colors">Tarım & Sanayi</span>
      </div>

      <div class="bg-slate-50 border border-slate-100 p-6 rounded-2xl flex flex-col items-center justify-center text-center group hover:bg-white hover:shadow-xl hover:border-red-200 hover:-translate-y-1 transition-all duration-300">
        <div class="w-16 h-16 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">🎓</div>
        <h4 class="font-['Poppins',sans-serif] font-bold text-slate-800 text-base group-hover:text-red-600 transition-colors">Manisa Özel Sevgi Dünyası</h4>
        <span class="text-xs text-slate-400 mt-1 font-medium bg-slate-100 group-hover:bg-red-50 group-hover:text-red-500 px-2.5 py-1 rounded-full transition-colors">Özel Eğitim Kurumu</span>
      </div>

      <div class="bg-slate-50 border border-slate-100 p-6 rounded-2xl flex flex-col items-center justify-center text-center group hover:bg-white hover:shadow-xl hover:border-red-200 hover:-translate-y-1 transition-all duration-300">
        <div class="w-16 h-16 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">🏫</div>
        <h4 class="font-['Poppins',sans-serif] font-bold text-slate-800 text-base group-hover:text-red-600 transition-colors">Salihli Dore Okulları</h4>
        <span class="text-xs text-slate-400 mt-1 font-medium bg-slate-100 group-hover:bg-red-50 group-hover:text-red-500 px-2.5 py-1 rounded-full transition-colors">Eğitim Kampüsü</span>
      </div>

      <div class="bg-slate-50 border border-slate-100 p-6 rounded-2xl flex flex-col items-center justify-center text-center group hover:bg-white hover:shadow-xl hover:border-red-200 hover:-translate-y-1 transition-all duration-300">
        <div class="w-16 h-16 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">🧪</div>
        <h4 class="font-['Poppins',sans-serif] font-bold text-slate-800 text-base group-hover:text-red-600 transition-colors">Enta Plastik</h4>
        <span class="text-xs text-slate-400 mt-1 font-medium bg-slate-100 group-hover:bg-red-50 group-hover:text-red-500 px-2.5 py-1 rounded-full transition-colors">Plastik & Ambalaj</span>
      </div>

      <div class="bg-slate-50 border border-slate-100 p-6 rounded-2xl flex flex-col items-center justify-center text-center group hover:bg-white hover:shadow-xl hover:border-red-200 hover:-translate-y-1 transition-all duration-300">
        <div class="w-16 h-16 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">🏗️</div>
        <h4 class="font-['Poppins',sans-serif] font-bold text-slate-800 text-base group-hover:text-red-600 transition-colors">Düzgün Panjur Sistemleri</h4>
        <span class="text-xs text-slate-400 mt-1 font-medium bg-slate-100 group-hover:bg-red-50 group-hover:text-red-500 px-2.5 py-1 rounded-full transition-colors">Yapı & Otomasyon</span>
      </div>
    </div>

    <div class="mt-12 p-4 rounded-xl bg-slate-50 text-center border border-slate-100 max-w-2xl mx-auto">
      <p class="text-xs text-slate-500 font-medium">🔒 Gizlilik sözleşmeleri gereğince bazı referanslarımız listelenmemiştir.</p>
    </div>
  </div>
</section>
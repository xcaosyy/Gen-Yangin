---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/site";
import type { GuidePageData } from "../data/seo";

interface Props {
  page: GuidePageData;
}

const { page } = Astro.props;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: page.h1,
  description: page.description,
  author: {
    "@type": "Organization",
    name: siteConfig.name,
  },
  publisher: {
    "@type": "Organization",
    name: siteConfig.name,
  },
  mainEntityOfPage: `${siteConfig.siteUrl}/${page.slug}`,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: page.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  pageTitle={page.title}
  description={page.description}
  canonical={`/${page.slug}`}
  ogType="article"
  jsonLd={[articleSchema, faqSchema]}
>
  <section class="bg-white py-16 md:py-20 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-6">
      <span class="text-xs font-black uppercase tracking-widest text-red-600 bg-red-50 border border-red-100 px-4 py-2 rounded-full">
        Yangın Yönetmeliği Rehberi
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight mt-6 mb-5">
        {page.h1}
      </h1>
      <p class="text-slate-600 text-base md:text-lg leading-relaxed max-w-3xl">
        {page.intro}
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8">
        <a href={siteConfig.whatsapp} target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3.5 rounded-xl text-sm text-center transition">
          Ücretsiz Ön Keşif
        </a>
        <a href="/yangin-danismanligi" class="bg-slate-100 hover:bg-slate-200 text-slate-900 font-bold px-6 py-3.5 rounded-xl text-sm text-center transition">
          Danışmanlık Al
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-slate-50 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-2xl font-black text-slate-900 tracking-tight mb-4">Mevzuat Bağlamı</h2>
      <p class="text-slate-700 leading-relaxed">{page.regulationContext}</p>
      <p class="text-xs text-slate-500 mt-4 leading-relaxed">
        Not: Bu sayfa bilgilendirme amaçlıdır. Resmi uygunluk için güncel yönetmelik metni, mimari proje ve saha birlikte değerlendirilmelidir.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <span class="text-red-600 text-xs font-black uppercase tracking-widest">Kontrol Noktaları</span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight mt-3">Denetim Öncesi Bakılması Gerekenler</h2>
      </div>
      <div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-4">
        {page.keyPoints.map((point) => (
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5">
            <p class="text-sm text-slate-700 leading-relaxed font-semibold">{point}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-950 text-white">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div>
        <span class="text-red-300 text-xs font-black uppercase tracking-widest">Sık Görülen Eksikler</span>
        <h2 class="text-3xl font-black tracking-tight mt-3 mb-6">Denetimde Risk Oluşturan Başlıklar</h2>
        <ul class="space-y-4">
          {page.inspectionRisks.map((risk) => (
            <li class="flex gap-3 text-sm text-slate-300 leading-relaxed">
              <span class="text-red-400 font-black">!</span>
              <span>{risk}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-white/10 border border-white/10 rounded-2xl p-6">
        <h2 class="text-xl font-black mb-5">Gen Yangın Nasıl Yaklaşır?</h2>
        <ul class="space-y-4">
          {page.genYanginApproach.map((item) => (
            <li class="flex gap-3 text-sm text-white leading-relaxed">
              <span class="text-emerald-400 font-black">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl font-black text-slate-900 tracking-tight text-center mb-10">Sık Sorulan Sorular</h2>
      <div class="space-y-4">
        {page.faqs.map((faq) => (
          <div class="bg-white border border-slate-200 rounded-2xl p-6">
            <h3 class="font-black text-slate-900 mb-2">{faq.question}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 bg-white border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-xl font-black text-slate-900 mb-5">İlgili Rehber ve Hizmetler</h2>
      <div class="flex flex-wrap gap-3">
        {page.related.map((item) => (
          <a href={item.href} class="text-xs font-bold text-slate-700 hover:text-red-700 bg-slate-50 hover:bg-red-50 px-4 py-2 rounded-full border border-slate-200 hover:border-red-200 transition">
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
